{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local ShadowMind window and the foundation command surface",
  "windows": ["main"],
  "permissions": [
    "allow-snapshot",
    "allow-update-preferences",
    "allow-session-action",
    "allow-choose-image",
    "allow-list-audio-sources",
    "allow-start-native-input",
    "allow-stop-native-inputs",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
